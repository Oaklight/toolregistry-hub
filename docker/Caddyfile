(unbuffered) {
	flush_interval -1
}

(admin_auth) {
	# Generate hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext YOUR_PASSWORD
	basic_auth {
		admin $2a$14$REPLACE_WITH_BCRYPT_HASH
	}
}

:8080 {
	handle /admin/openapi* {
		import admin_auth
		uri strip_prefix /admin/openapi
		reverse_proxy openapi:8001
	}

	handle /admin/mcp-http* {
		import admin_auth
		uri strip_prefix /admin/mcp-http
		reverse_proxy mcp-streamable-http:8001
	}

	handle /admin/mcp-sse* {
		import admin_auth
		uri strip_prefix /admin/mcp-sse
		reverse_proxy mcp-sse:8001
	}

	handle /admin {
		import admin_auth
		respond "Admin Panels:
- /admin/openapi/
- /admin/mcp-http/
- /admin/mcp-sse/
" 200
	}

	handle /mcp {
		reverse_proxy mcp-streamable-http:8000 {
			import unbuffered
		}
	}

	handle /sse* {
		reverse_proxy mcp-sse:8000 {
			import unbuffered
		}
	}

	handle /openapi {
		redir /docs permanent
	}

	handle {
		reverse_proxy openapi:8000 {
			import unbuffered
		}
	}
}
